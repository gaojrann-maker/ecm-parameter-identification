# Bohrium Agent SDK 配置文件示例
# 复制此文件为 .env 并填入实际值

# ============================================================
# LLM API 配置（Agent 对话模式必需）
# ============================================================
# 选择你使用的 LLM 模型（格式: provider/model-name）
# 可选: deepseek/deepseek-chat, openai/gpt-4o, openai/gpt-4o-mini,
#       anthropic/claude-3-5-sonnet, 等
MODEL=deepseek/deepseek-chat

# DeepSeek API（如果使用 DeepSeek）
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API（如果使用 OpenAI）
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API（如果使用 Claude）
# 从 https://console.anthropic.com/ 获取
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# Bohrium 认证配置（平台部署必需）
# ============================================================
# 从 https://www.bohrium.com/settings/user 获取
BOHR_ACCESS_KEY=your_access_key_here
BOHR_APP_KEY=your_app_key_here

# ============================================================
# 数据路径配置（可选）
# ============================================================
# 默认数据目录
ECM_DATA_DIR=/data

# 默认数据文件路径
ECM_DATA_PATH=/data/B0005.mat

# 默认输出目录
ECM_OUTPUT_DIR=outputs

# ============================================================
# 服务配置（可选）
# ============================================================
# MCP Server 端口（默认 50001）
MCP_SERVER_PORT=50001

# ============================================================
# Bohrium 计算资源配置（云模式可选）
# ============================================================
BOHRIUM_USERNAME=your_username
BOHRIUM_PASSWORD=your_password
